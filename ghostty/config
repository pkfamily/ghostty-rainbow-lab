# Ghostty config — reload with cmd+shift+,
# Full reference: `ghostty +show-config --default --docs`

# --- Appearance ---
theme = Rainbow
font-family = JetBrainsMono Nerd Font Mono
font-size = 14
font-thicken = true
background-opacity = 0.95
background-blur-radius = 20
cursor-style = block
cursor-style-blink = false
adjust-cell-height = 10%

# --- Window / macOS ---
macos-titlebar-style = tabs
macos-option-as-alt = true
window-save-state = always
window-padding-x = 8
window-padding-y = 6
window-padding-balance = true
window-inherit-working-directory = true
window-inherit-font-size = true

# --- Behavior ---
copy-on-select = clipboard
mouse-hide-while-typing = true
confirm-close-surface = false
shell-integration = detect
# NOTE: this list is ADDITIVE over Ghostty's defaults, not a replacement. Omitting
# a feature does not disable it — you need the `no-` prefix. Check the effective
# value with `ghostty +show-config`, not by reading this line.
#
# `no-title` hands the tab title to zsh/zshrc-additions.zsh, which prefixes a
# marker in Claude Code sessions. Ghostty installs its title hook from a deferred
# precmd that runs after ~/.zshrc, so there is nothing to append to at rc time,
# and it forces its hook last — the two cannot cooperate, only one can win.
shell-integration-features = cursor,sudo,no-title
scrollback-limit = 100000

# --- Quake-style drop-down terminal (toggle with cmd+`) ---
keybind = global:cmd+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-animation-duration = 0.15

# --- Handy keybinds ---
keybind = cmd+shift+f=toggle_fullscreen
keybind = cmd+k=clear_screen
